{
  "$schema": "https://json.schemastore.org/package",
  "name": "elixirmedics-backend",
  "version": "1.1.0",
  "private": true,
  "description": "Secure member auth and search API for Elixir Medics.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
